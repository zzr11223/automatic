# ============================================================
#  personal / 不要提交
# ============================================================

# ★ 账号密码
credentials.json

# ★ 登录状态（含 cookie，等于你的登录凭证）
userdata/
userdata-*/

# ★ 你写的小说 + 发布记录 + 字数账本
#   一本书一个文件夹，里面有正文、progress.json、daily.json —— 全都不进仓库。
#   想给别人看结构？看 templates/ 目录里的模板。
books/

# ★ 本地配置（从 templates/config.example.json 复制而来）
config.json

# ★ 运行产物与诊断（含后台截图、页面结构 dump、定时任务日志）
logs/
data/

# ============================================================
#  其他
# ============================================================

# 依赖
node_modules/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# 临时与备份
*.bak
*.bak-*
*.old
*.tmp

# AI 助手的工作记忆（个人项目笔记，与工具本身无关）
.workbuddy/
